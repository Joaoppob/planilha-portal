# Radar de Oportunidades Acadêmicas — variáveis de ambiente
# Copie para `.env` (nunca commitado) e preencha.

# Token do bot Telegram — obtido com @BotFather (ver README.md)
TELEGRAM_BOT_TOKEN=

# ID do chat/usuário que recebe as notificações
# Descubra enviando uma mensagem ao bot e consultando:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Opcional — chat dedicado para ALERTAS DE SAÚDE do coletor (item 3 da Onda 1.5:
# canal separado do alerta de vaga). Se vazio, usa TELEGRAM_CHAT_ID mesmo (mesmo
# bot/chat, mas mensagem com prefixo distinto — ver lib/telegram.js formatarAlertaSaude).
TELEGRAM_CHAT_ID_SAUDE=

# --- Google Sheets (espelho do store, `node radar.js sincronizar-sheets`) ---
# Sem as 3 variáveis abaixo preenchidas, o sync cai em dry-run sozinho — o
# resto do radar (coletar/julgar/notificar) funciona normalmente sem elas.
# Guia de setup passo a passo (criar a planilha, criar a service account no
# Google Cloud, baixar a chave, compartilhar a planilha): ver README.md
# §Google Sheets.

# ID da planilha — o trecho entre /d/ e /edit na URL:
# https://docs.google.com/spreadsheets/d/<ESTE_TRECHO>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Campo "client_email" do arquivo JSON da service account baixado no Google
# Cloud Console (ex.: radar-jb@meu-projeto.iam.gserviceaccount.com).
GOOGLE_SHEETS_CLIENT_EMAIL=

# Campo "private_key" do MESMO arquivo JSON — copie o valor exatamente como
# está no JSON, incluindo as sequências \n literais (não são quebra de
# linha de verdade, são dois caracteres "\" + "n" — é assim que o JSON já
# guarda o valor; cole entre aspas, numa linha só). Ex. de formato esperado
# (chave de exemplo, não uma chave real):
# GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_PRIVATE_KEY=
